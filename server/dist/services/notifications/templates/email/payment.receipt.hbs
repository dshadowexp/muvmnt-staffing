{{#> email-base previewText="Payment received — {{currency amount}}"}}
  {{#*inline "body"}}
    <p class="label">Payment received</p>
    <h1>{{currency amount}}</h1>

    <div class="details">
      <div class="detail-row">
        <span class="detail-key">Reference</span>
        <span class="detail-value">{{reference}}</span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Date</span>
        <span class="detail-value">{{date paidAt}}</span>
      </div>
      {{#if method}}
      <div class="detail-row">
        <span class="detail-key">Method</span>
        <span class="detail-value">{{method}}</span>
      </div>
      {{/if}}
    </div>

    <p>Thanks, {{name}}.</p>
  {{/inline}}
{{/email-base}}
