{
  "name": "muvmnt-staffing",
  "description": "Simple api sample in Node",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run copy:templates",
    "start": "node dist/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "copy:templates": "cp -r src/services/notifications/templates dist/services/notifications/templates"
  },
  "author": "Google LLC",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.11",
    "nodemon": "^3.1.0",
    "pm2": "^6.0.14",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@supabase/supabase-js": "^2.98.0",
    "axios": "^1.13.6",
    "bullmq": "^5.70.4",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "fastify-raw-body": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "firebase-admin": "^10.3.0",
    "h3-js": "^4.4.0",
    "handlebars": "^4.7.8",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "stripe": "^20.4.1",
    "twilio": "^5.12.2",
    "zod": "^4.3.6"
  }
}
