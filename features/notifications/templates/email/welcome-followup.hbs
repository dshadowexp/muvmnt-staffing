{{#> email-base previewText="A few quick next steps"}}
  {{#*inline "body"}}
    <p class="label">Getting started</p>
    <h1>{{#if firstName}}Hey {{firstName}},{{else}}Welcome.{{/if}}</h1>
    <p>Thanks for signing up to <strong>readykare</strong>. Here are a couple of things you can do next to get the most out of your account:</p>

    {{#if isWorker}}
      <div class="details">
        <div class="detail-row"><span class="detail-key">1.</span><span class="detail-value">Verify your email address and phone number</span></div>
        <div class="detail-row"><span class="detail-key">2.</span><span class="detail-value">Complete your profile</span></div>
        <div class="detail-row"><span class="detail-key">3.</span><span class="detail-value">Set your location</span></div>
        <div class="detail-row"><span class="detail-key">4.</span><span class="detail-value">Complete your AI video interview (takes about 10–15 minutes)</span></div>
        <div class="detail-row"><span class="detail-key">5.</span><span class="detail-value">Verify your identity with a government-issued ID</span></div>
        <div class="detail-row"><span class="detail-key">6.</span><span class="detail-value">Submit your work authorization — SIN and supporting document</span></div>
        <div class="detail-row"><span class="detail-key">7.</span><span class="detail-value">Set up your payroll account for direct deposit</span></div>
        <div class="detail-row"><span class="detail-key">8.</span><span class="detail-value">Set your weekly availability</span></div>
        <div class="detail-row"><span class="detail-key">9.</span><span class="detail-value">You're live — shift offers will start coming in!</span></div>
      </div>
    {{else}}
      <div class="details">
        <div class="detail-row"><span class="detail-key">1.</span><span class="detail-value">Tell us about your facility</span></div>
        <div class="detail-row"><span class="detail-key">2.</span><span class="detail-value">Add a billing method</span></div>
        <div class="detail-row"><span class="detail-key">3.</span><span class="detail-value">Post your first staffing request</span></div>
        <div class="detail-row"><span class="detail-key">4.</span><span class="detail-value">Voila! Staffing issues fixed!.</span></div>
      </div>
    {{/if}}

    {{#if dashboardUrl}}
      <a href="{{dashboardUrl}}" class="btn">Go to dashboard</a>
    {{/if}}
  {{/inline}}
{{/email-base}}
