{{#> email-base previewText="You're invited to join ReadyKare"}}
  {{#*inline "body"}}
    <p class="label">Invitation</p>
    <h1>Join ReadyKare as a healthcare professional.</h1>
    <p>{{#if inviterName}}{{inviterName}} from{{else}}Our team at{{/if}} <strong>ReadyKare</strong> invited you to create a worker account.</p>
    <p>Accept the invitation to set up your profile, complete onboarding, and start picking up shifts in your area.</p>
    <a href="{{inviteUrl}}" class="btn">Accept invitation</a>
    <div class="divider"></div>
    <p style="font-size:13px;color:#888;">
      If the button doesn't work, copy and paste this link into your browser:<br>
      <a href="{{inviteUrl}}" style="color:#888;word-break:break-all;">{{inviteUrl}}</a>
    </p>
  {{/inline}}
{{/email-base}}
