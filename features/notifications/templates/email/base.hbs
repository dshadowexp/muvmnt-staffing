<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{{previewText}}</title>
  <!--[if mso]>
  <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
  <![endif]-->
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      font-size: 16px;
      line-height: 1.5;
      color: #0a0a0a;
      -webkit-font-smoothing: antialiased;
    }

    .wrapper {
      width: 100%;
      background-color: #ffffff;
      padding: 48px 0;
    }

    .container {
      max-width: 520px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ─── Logo ─────────────────────────────────────── */
    .logo {
      margin-bottom: 48px;
    }

    .logo-mark {
      display: inline-block;
      width: 36px;
      height: 36px;
      background-color: #0a0a0a;
      border-radius: 8px;
    }

    /* ─── Content ──────────────────────────────────── */
    .content {
      margin-bottom: 48px;
    }

    .label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #888888;
      margin-bottom: 12px;
    }

    h1 {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
      color: #0a0a0a;
      margin-bottom: 16px;
    }

    p {
      font-size: 16px;
      color: #444444;
      margin-bottom: 12px;
      line-height: 1.6;
    }

    /* ─── Amount block ─────────────────────────────── */
    .amount-block {
      margin: 32px 0;
      padding: 28px 0;
      border-top: 1px solid #f0f0f0;
      border-bottom: 1px solid #f0f0f0;
    }

    .amount-value {
      font-size: 40px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #0a0a0a;
      line-height: 1;
    }

    .amount-label {
      font-size: 13px;
      color: #888888;
      margin-top: 6px;
    }

    /* ─── Detail rows ──────────────────────────────── */
    .details {
      margin: 24px 0;
      border-top: 1px solid #f0f0f0;
    }

    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0;
      border-bottom: 1px solid #f0f0f0;
      font-size: 15px;
    }

    .detail-key {
      color: #888888;
    }

    .detail-value {
      color: #0a0a0a;
      font-weight: 500;
    }

    /* ─── Button ───────────────────────────────────── */
    .btn {
      display: inline-block;
      margin-top: 24px;
      padding: 14px 28px;
      background-color: #0a0a0a;
      color: #ffffff !important;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      border-radius: 100px;
      letter-spacing: -0.01em;
    }

    .btn-outline {
      background-color: transparent;
      color: #0a0a0a !important;
      border: 1.5px solid #0a0a0a;
    }

    /* ─── Divider ──────────────────────────────────── */
    .divider {
      height: 1px;
      background-color: #f0f0f0;
      margin: 32px 0;
    }

    /* ─── Footer ───────────────────────────────────── */
    .footer {
      padding-top: 32px;
      border-top: 1px solid #f0f0f0;
    }

    .footer p {
      font-size: 12px;
      color: #aaaaaa;
      line-height: 1.6;
      margin-bottom: 4px;
    }

    .footer a {
      color: #aaaaaa;
      text-decoration: underline;
    }

    /* ─── Responsive ───────────────────────────────── */
    @media (max-width: 600px) {
      .wrapper { padding: 32px 0; }
      h1 { font-size: 24px; }
      .amount-value { font-size: 32px; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">

      <!-- Logo -->
      <div class="logo">
        <img 
          src="https://readykare.com/logo.png" 
          alt="ReadyKare" 
          width="36" 
          style="display:block; border-radius:8px;" 
        />
      </div>

      <!-- Injected content from each template -->
      <div class="content">
        {{> body}}
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>You're receiving this because you have an account with us.</p>
      </div>

    </div>
  </div>
</body>
</html>
