{{#> email-base previewText="You've been invited to join your team on ReadyKare"}}
  {{#*inline "body"}}
    <p class="label">Team invitation</p>
    <h1>You've been invited to join <strong>{{facilityName}}</strong> on ReadyKare.</h1>
    <p>Use the email address this invitation was sent to (<strong>{{email}}</strong>) when you create your account or sign in.</p>
    <a href="{{joinUrl}}" class="btn">Accept invitation</a>
    <div class="divider"></div>
    <p style="font-size:13px;color:#6b7280;">This link expires on {{expiresDate}}.</p>
    <p style="font-size:13px;color:#888;">
      If the button doesn't work, copy and paste this link into your browser:<br>
      <a href="{{joinUrl}}" style="color:#888;word-break:break-all;">{{joinUrl}}</a>
    </p>
  {{/inline}}
{{/email-base}}
