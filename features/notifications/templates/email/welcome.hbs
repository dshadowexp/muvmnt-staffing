{{#> email-base previewText="Welcome to the platform"}}
  {{#*inline "body"}}
    <p class="label">Getting started</p>
    <h1>Welcome,<br>{{name}}.</h1>
    <p>Your <strong>{{role}}</strong> account is ready. Everything you need is in the app.</p>
    {{#if verifyUrl}}
      <a href="{{verifyUrl}}" class="btn">Verify your email</a>
    {{/if}}
  {{/inline}}
{{/email-base}}
