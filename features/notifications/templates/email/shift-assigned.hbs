{{#> email-base previewText=previewText}}
  {{#*inline "body"}}
    <p class="label">Shift assignment</p>
    <h1>New shift<br>assigned.</h1>
    <p>Hi {{workerFirstName}}, you have a new shift from <strong>{{clientName}}</strong>. Please confirm or decline below.</p>

    <div class="details">
      <div class="detail-row">
        <span class="detail-key">When</span>
        <span class="detail-value" style="text-align:right;max-width:60%">{{whenLine}}</span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Location</span>
        <span class="detail-value" style="text-align:right;max-width:60%">{{address}}</span>
      </div>
      <div class="detail-row">
        <span class="detail-key">Rate</span>
        <span class="detail-value">{{rateLine}}</span>
      </div>
    </div>

    <p style="margin-top:28px;margin-bottom:8px;font-size:14px;color:#666">Respond from this email:</p>
    <a href="{{confirmUrl}}" class="btn">Confirm shift</a>
    <a href="{{declineUrl}}" class="btn btn-outline" style="margin-left:12px">Decline</a>

    <p style="margin-top:32px;font-size:13px;color:#888">Links expire in 14 days. If the buttons do not work, copy the URL into your browser.</p>
  {{/inline}}
{{/email-base}}
